# Telegram Bot Token from @BotFather
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Allowed Telegram User IDs (comma-separated). Empty means deny all.
TELEGRAM_ALLOWED_USERS=123456789
TELEGRAM_OWNER_ID=123456789
# Explicit public-mode opt-in. Keep false for a private bot.
TELEGRAM_ALLOW_ALL_USERS=false

# OMP Gateway & Model Configuration (Hermes / Antigravity Gateway)
OMP_BASE_URL=http://127.0.0.1:4000/v1
OMP_API_KEY=
DEFAULT_MODEL=flash
REASONING_EFFORT=medium
MAX_OUTPUT_TOKENS=8192
API_MAX_RETRIES=3
REQUEST_TIMEOUT_SECONDS=180
MAX_INPUT_CHARS=24000
MAX_DOWNLOAD_BYTES=10485760
STARTUP_NOTIFICATION=false
