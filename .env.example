# Copy this file to .env and replace the Telegram placeholders.
# Never commit .env or actual credentials.
# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_ALLOWED_USERS=123456789
TELEGRAM_ALLOW_ALL_USERS=false
TELEGRAM_OWNER_ID=123456789

# AI Model & Gateway Configuration
DEFAULT_MODEL=google-antigravity/gemini-3.8-flash
# Default: direct authenticated agy CLI. Set AGY_TRANSPORT=omp only for the legacy gateway.
AGY_TRANSPORT=agy
AGY_CLI_PATH=agy
REASONING_EFFORT=high
MAX_OUTPUT_TOKENS=8192
API_MAX_RETRIES=5
REQUEST_TIMEOUT_SECONDS=180
STARTUP_NOTIFICATION=false

# Security & Constraints
MAX_INPUT_CHARS=24000
MAX_DOWNLOAD_BYTES=10485760

# Sandbox is ON by default and stored in the runtime database, not in .env.
# Linux/WSL requires: sudo apt install bubblewrap (both sandbox modes isolate AGY state)
# Only the owner can toggle it in a private chat: /sandbox on or /sandbox off.

# Optional legacy OMP gateway (unused with AGY_TRANSPORT=agy).
# OMP generation requires explicitly disabling sandbox via /sandbox off.
OMP_BASE_URL=http://127.0.0.1:4000/v1
OMP_API_KEY=
