[Unit]
Description=Geminka (Columbina) Telegram AI Agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Example only: run.sh generates a service for the actual checkout directory.
WorkingDirectory=%h/projects/geminka-agent
ExecStart=%h/projects/geminka-agent/scripts/start.sh
Restart=always
RestartSec=3
KillMode=control-group
Environment=PYTHONUNBUFFERED=1
Environment=PATH=%h/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
